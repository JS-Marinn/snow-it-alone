; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Snow It Together"
config/description="Cozy first-person snow clearing prototype with granular snow physics."
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

SaveSystem="*res://scripts/save_system.gd"
; The Godot AI editor helper used to be listed here as `_mcp_game_helper`. It is an
; editor-side autoload: its own header says the PLUGIN registers it "when the Godot AI
; plugin is enabled". Declaring it here forced it into every run of the game and every
; battery, with the plugin off, and no script in this project references it. Removed so
; the shipped game does not carry an editor tool. The plugin registers it again by
; itself when it is enabled; if a tool needs it sooner, restore the line:
;   _mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[gui]

theme/custom="res://default_theme.tres"
theme/custom_font="res://fonts/default_font.tres"

[input]

